generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  members   User[]
  tasks     Task[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  workspaceId  String
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  sessions     Session[]
  tasks        Task[]    @relation("TaskCreator")

  @@index([workspaceId])
}

model SignupChallenge {
  id           String   @id
  email        String   @unique
  passwordHash String
  otpHash      String
  attemptsLeft Int
  expiresAt    DateTime
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Task {
  id          String     @id @default(uuid())
  workspaceId String
  createdById String
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([createdById])
}
